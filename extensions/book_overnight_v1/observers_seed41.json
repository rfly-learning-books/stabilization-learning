{
  "schema": "unified_training_v4",
  "maximum_minutes": 90,
  "minimum_free_gib": 20,
  "deterministic": true,
  "runtime_lock": "configs/reproducible_training_v4/runtime_cpu_lock_v3.json",
  "scope": "Single-seed full-horizon known-input observation and cooperative-target pose estimation; no unknown-scene motion or coupled control acceptance.",
  "jobs": [
    {
      "id": "observer_motor_speed",
      "backend": "observer_model_gradient",
      "config": {
        "task": "motor_speed",
        "seed": 41,
        "cpu_threads": 1,
        "batch_size": 16,
        "hidden": 32,
        "metric_radius": 3,
        "learning_rate": 0.003,
        "gradient_clip": 2,
        "training_index_start": 1000,
        "validation_index_start": 72000,
        "test_index_start": 80000,
        "validation_count": 32,
        "test_count": 192,
        "scenarios": [
          "nominal",
          "noise",
          "occlusion",
          "mismatch"
        ],
        "validation_scenarios": [
          "nominal",
          "noise",
          "occlusion",
          "mismatch"
        ],
        "test_scenarios": [
          "nominal",
          "noise",
          "occlusion",
          "mismatch",
          "bounded_noise",
          "initial_offset"
        ]
      },
      "schedule": {
        "warmup_representation": 0,
        "pretrain_evaluator": 0,
        "epochs": 16,
        "representation_updates": 0,
        "evaluator_updates": 0,
        "certificate_updates": 64
      },
      "test_variants": [
        "selected",
        "initial",
        "identity",
        "fixed_M"
      ]
    },
