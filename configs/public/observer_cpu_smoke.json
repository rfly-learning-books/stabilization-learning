          "mismatch"
        ],
        "validation_scenarios": [
          "nominal"
        ],
        "test_scenarios": [
          "nominal"
        ]
      },
      "schedule": {
        "warmup_representation": 0,
        "pretrain_evaluator": 0,
        "epochs": 1,
        "representation_updates": 0,
        "evaluator_updates": 0,
        "certificate_updates": 1
      },
